{
  "name": "8colors-process-engine",
  "version": "0.5.0",
  "description": "Portable Claude Code process engine — 9 agents + 2 session skills + 4 commands + launchd templates + multi-provider RAG (fastembed default, no API key) + unified pe CLI. OSS-first doctrine baked in.",
  "author": "8Colors",
  "license": "MIT",
  "homepage": "https://github.com/sanishsk/8colors-process-engine",
  "agents_dir": "agents",
  "commands_dir": "commands",
  "skills_dir": "skills",
  "scripts_dir": "scripts",
  "templates_dir": "templates",
  "config_template": "templates/process-engine.yaml.template",
  "installers": {
    "core": "scripts/install.sh",
    "launchd": "scripts/install_launchd.sh"
  },
  "cli": "scripts/pe",
  "rag": {
    "enabled": true,
    "script": "scripts/research_index.py",
    "command": "commands/research-search.md",
    "doctrine": "docs/RAG.md",
    "default_provider": "fastembed",
    "default_model": "BAAI/bge-small-en-v1.5",
    "default_dim": 384,
    "providers": ["fastembed", "voyage", "gemini", "openai"]
  }
}
