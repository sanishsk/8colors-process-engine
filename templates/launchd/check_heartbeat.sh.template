#!/usr/bin/env bash
# {{ORG_TAG}} CEO weekly retro heartbeat watchdog.
#
# Lives outside ~/Documents (TCC-safe). Independent of the weekly job —
# if the weekly silently dies, this still fires within ~72h.

set -euo pipefail

PROJECT_ROOT="{{PROJECT_ROOT}}"
STATE_FILE="$PROJECT_ROOT/docs/dev-log/ceo-state.json"
STALE_MARKER="$PROJECT_ROOT/docs/dev-log/CEO_STALE.md"
ORG_TAG="{{ORG_TAG}}"

[ -f "$STATE_FILE" ] || exit 0

DAYS_STALE=$(/usr/bin/python3 - <<PYEOF
import json, sys
from datetime import datetime, timezone
try:
    with open("$STATE_FILE") as f:
        s = json.load(f)
    last = s.get("last_run", "")
    if not last:
        print(-1); sys.exit(0)
    last_dt = datetime.fromisoformat(last.replace("Z", "+00:00"))
    delta = datetime.now(timezone.utc) - last_dt
    print(delta.days)
except Exception:
    print(-1)
PYEOF
)

if [ "$DAYS_STALE" -gt 8 ]; then
    /usr/bin/osascript -e "display notification \"CEO weekly retro is $DAYS_STALE days stale. The Friday LaunchAgent may have died. Run ~/.local/bin/${ORG_TAG}-ceo/run_weekly.sh --force and check launchctl.\" with title \"${ORG_TAG} CEO STALE\" sound name \"Sosumi\"" || true

    cat > "$STALE_MARKER" <<MARKER
# ⚠️ CEO WEEKLY RETRO STALE

> Generated by check_heartbeat.sh on $(/bin/date -Iseconds)

The CEO weekly retro is **$DAYS_STALE days** old. Expected cadence is
every Friday at 17:00 via \`com.${ORG_TAG}.ceo.weekly\`. Diagnose:

\`\`\`bash
launchctl list | grep ceo
tail ~/Library/Logs/${ORG_TAG}-ceo/run-*.log | tail -50
~/.local/bin/${ORG_TAG}-ceo/run_weekly.sh --force
\`\`\`

Delete this file once the weekly job is healthy again.
MARKER
fi

exit 0
