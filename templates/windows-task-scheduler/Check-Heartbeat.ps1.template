# {{ORG_TAG}} CEO weekly retro heartbeat watchdog (Windows).
# Fires every 3 days; writes CEO_STALE.md if last_run > 8 days.

$ErrorActionPreference = "Stop"

$OrgTag      = "{{ORG_TAG}}"
$ProjectRoot = "{{PROJECT_ROOT}}"

$StateFile = Join-Path $ProjectRoot "docs\dev-log\ceo-state.json"
$StaleMarker = Join-Path $ProjectRoot "docs\dev-log\CEO_STALE.md"

if (-not (Test-Path $StateFile)) { exit 0 }

try {
    $state = Get-Content $StateFile -Raw | ConvertFrom-Json
    $lastRun = [DateTime]::Parse($state.last_run)
    $daysStale = [int]((Get-Date) - $lastRun).TotalDays
} catch {
    exit 0
}

if ($daysStale -gt 8) {
    # Toast notification via BurntToast if installed, else just write marker
    if (Get-Module -ListAvailable -Name BurntToast) {
        Import-Module BurntToast
        New-BurntToastNotification `
            -Text "$OrgTag CEO STALE", "Weekly retro is $daysStale days stale." `
            -ErrorAction SilentlyContinue
    }

    $marker = @"
# ⚠ CEO WEEKLY RETRO STALE

> Generated by Check-Heartbeat.ps1 on $(Get-Date -Format o)

The CEO weekly retro is **$daysStale days** old. Expected cadence:
every Friday at 17:00 via Windows Task Scheduler. Diagnose:

```powershell
Get-ScheduledTaskInfo -TaskName "$OrgTag-ceo-weekly"
Get-ScheduledTask -TaskName "$OrgTag-ceo-*"
Get-Content "$env:LOCALAPPDATA\$OrgTag-ceo\logs\run-*.log" -Tail 50
& "$env:LOCALAPPDATA\$OrgTag-ceo\Run-Weekly.ps1" -Force
```

Delete this file once the weekly job is healthy again.
"@
    Set-Content $StaleMarker $marker
}

exit 0
