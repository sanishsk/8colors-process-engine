# ─── Cases ───────────────────────────────────────────────────────────

def test_login_returns_401_on_wrong_password(existing_user):
    resp = _call_login(existing_user.email, "definitely-wrong")
    assert resp.status_code == 401, f"expected 401, got {resp.status_code}"


def test_login_returns_401_on_unknown_user():
    resp = _call_login("nobody@example.invalid", "whatever")
    assert resp.status_code == 401, f"expected 401, got {resp.status_code}"


def test_login_handles_legacy_malformed_bcrypt_hash(existing_user):
    """The exact 8CStudio audit case: `ValueError: Invalid salt`."""
    _set_stored_hash(existing_user, "not-a-real-bcrypt-hash")
    resp = _call_login(existing_user.email, "any-password")
    assert resp.status_code in (401, 400), \
        f"malformed hash must not 500; got {resp.status_code}"


def test_login_handles_empty_stored_hash(existing_user):
    _set_stored_hash(existing_user, "")
    resp = _call_login(existing_user.email, "any-password")
    assert resp.status_code in (401, 400), \
        f"empty hash must not 500; got {resp.status_code}"


def test_login_handles_null_bytes_in_password(existing_user):
    resp = _call_login(existing_user.email, "password\x00malicious")
    assert resp.status_code in (401, 400), \
        f"null bytes in input must not 500; got {resp.status_code}"


def test_login_handles_oversized_email():
    huge = "a" * 10_000 + "@example.com"
    resp = _call_login(huge, "any-password")
    assert resp.status_code in (400, 401, 413), \
        f"oversized email must not 500; got {resp.status_code}"


def test_login_handles_oversized_password(existing_user):
    resp = _call_login(existing_user.email, "x" * 100_000)
    assert resp.status_code in (400, 401, 413), \
        f"oversized password must not 500; got {resp.status_code}"


def test_login_handles_none_password_gracefully(existing_user):
    # Some clients send JSON `{"password": null}` — must not 500.
    resp = _call_login(existing_user.email, None)  # type: ignore
    assert resp.status_code in (400, 401), \
        f"null password must not 500; got {resp.status_code}"


