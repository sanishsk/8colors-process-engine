# jwt-security.test — JWT failure modes that keep shipping to prod
# (S3). Every test here is a documented, exploited-in-the-wild attack.
#
# Threat model: attacker who can forge JWT strings but doesn't have
# the signing secret. All cases MUST reject; a PASS means silent
# authentication bypass.
#
# Adopter customization:
#   - Wire `_authenticate_with_token(client, token)` to your protected
#     endpoint (returns response object).
#   - Wire `_sign_token(payload, secret, alg)` — usually thin wrapper
#     over `jwt.encode` from PyJWT / python-jose.
#   - `_get_public_key()` returns the RS256 public key as PEM bytes.

import base64
import json
import time

import pytest


# ─── Adopter wires these ────────────────────────────────────────────
def _authenticate_with_token(client, token: str):
    raise NotImplementedError("wire to your token-protected endpoint")


def _sign_token(payload: dict, secret: str, alg: str = "HS256") -> str:
    raise NotImplementedError("wire to your JWT signer (usually PyJWT)")


def _get_public_key() -> bytes:
    """Return the RS256 public key PEM the app verifies with."""
    raise NotImplementedError("wire to your public-key source")


@pytest.fixture
def client():
    pytest.skip("adopter must provide a test client fixture")


# ─── Cases ──────────────────────────────────────────────────────────


def test_alg_none_rejected(client):
    """CVE-2015-9235 pattern. An unsigned token with alg=none MUST
    be rejected. If accepted, an attacker forges any user."""
    header = {"alg": "none", "typ": "JWT"}
    payload = {"sub": "victim", "exp": int(time.time()) + 3600}
    b64 = lambda d: base64.urlsafe_b64encode(
        json.dumps(d).encode()
    ).rstrip(b"=").decode()
    token = f"{b64(header)}.{b64(payload)}."

    r = _authenticate_with_token(client, token)
    assert r.status_code in (401, 403), (
        "alg=none token was accepted — trivial auth bypass"
    )


def test_algorithm_confusion_rs256_to_hs256_rejected(client):
    """CVE-2016-10555 pattern. If the verifier uses `algorithms=None`
    (allow-any), attacker signs an HS256 token using the RS256 PUBLIC
    key as the HMAC secret. Verifier retrieves the same public key
    and validates as HMAC → auth bypass.

    The verifier MUST pin `algorithms=["RS256"]` (or whatever the
    single expected alg is) — allow-any is the bug."""
    public_key = _get_public_key()
    payload = {"sub": "victim", "exp": int(time.time()) + 3600}
    forged = _sign_token(payload, public_key.decode(), alg="HS256")

    r = _authenticate_with_token(client, forged)
    assert r.status_code in (401, 403), (
        "ALG CONFUSION: HS256 token signed with RS256 public key was "
        "accepted. Pin `algorithms=[<your alg>]` at verify time."
    )


def test_expired_token_rejected(client):
    """A token with `exp` in the past MUST be rejected. Common bug:
    verifier passes `options={'verify_exp': False}`."""
    payload = {"sub": "victim", "exp": int(time.time()) - 3600}
    token = _sign_token(payload, "test-secret", alg="HS256")

    r = _authenticate_with_token(client, token)
    assert r.status_code in (401, 403), (
        "expired token was accepted — verify_exp is off"
    )


def test_missing_exp_claim_rejected(client):
    """No `exp` claim = never-expiring token = permanent credential
    if the key ever leaks. Reject tokens without an expiration."""
    payload = {"sub": "victim"}  # no exp
    token = _sign_token(payload, "test-secret", alg="HS256")

    r = _authenticate_with_token(client, token)
    assert r.status_code in (401, 403), (
        "token without exp claim accepted — never-expiring credential"
    )


def test_wrong_signature_rejected(client):
    """Token signed with a DIFFERENT secret MUST be rejected."""
    payload = {"sub": "victim", "exp": int(time.time()) + 3600}
    forged = _sign_token(payload, "attacker-secret", alg="HS256")

    r = _authenticate_with_token(client, forged)
    assert r.status_code in (401, 403), (
        "token with wrong-secret signature accepted"
    )


def test_missing_signature_rejected(client):
    """A token with header + payload but empty signature MUST be
    rejected (defense in depth for alg=none)."""
    header = {"alg": "HS256", "typ": "JWT"}
    payload = {"sub": "victim", "exp": int(time.time()) + 3600}
    b64 = lambda d: base64.urlsafe_b64encode(
        json.dumps(d).encode()
    ).rstrip(b"=").decode()
    token = f"{b64(header)}.{b64(payload)}."  # empty sig

    r = _authenticate_with_token(client, token)
    assert r.status_code in (401, 403), (
        "token with empty signature accepted"
    )


def test_wrong_issuer_rejected(client):
    """If the verifier is configured with `iss=my-app`, a token
    with `iss=attacker` MUST be rejected. Skip if you don't use
    iss claims — but consider adding them."""
    payload = {
        "sub": "victim",
        "iss": "https://attacker.example.com",
        "exp": int(time.time()) + 3600,
    }
    token = _sign_token(payload, "test-secret", alg="HS256")

    r = _authenticate_with_token(client, token)
    assert r.status_code in (401, 403), (
        "token with wrong iss claim accepted"
    )
