# session-security.test — the failure modes that leak sessions in
# production (S3). Adapted from OWASP ASVS §3 (Session Management) +
# 8CStudio audit findings.
#
# Threat model: an attacker with network access + a legit user with a
# stale/pre-auth session cookie. All cases below MUST hold or the
# session layer is broken by design.
#
# Adopter customization:
#   - Wire `_login(client, email, password)` and `_logout(client)`.
#   - Wire `_change_password(client, user, new_pw)`.
#   - `client` is your framework's test client (Flask app.test_client(),
#     Django Client(), etc.).
#   - Delete a case only if it truly doesn't apply — never silent-skip.

import pytest


# ─── Adopter wires these ────────────────────────────────────────────
def _login(client, email: str, password: str):
    """Perform login, return response. Should set the session cookie."""
    raise NotImplementedError("wire to your login endpoint")


def _logout(client):
    """Perform logout, return response."""
    raise NotImplementedError("wire to your logout endpoint")


def _change_password(client, user, new_password: str):
    """Perform authenticated password change."""
    raise NotImplementedError("wire to your password-change endpoint")


def _session_cookie_name() -> str:
    """The session cookie name (Flask default: 'session';
    Django default: 'sessionid'). Override per project."""
    return "session"


