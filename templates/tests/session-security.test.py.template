# ─── Cases ──────────────────────────────────────────────────────────


def test_session_id_rotates_on_login(client, existing_user):
    """Session fixation: the ID before login MUST NOT equal the ID
    after login. Attacker who plants a known session ID pre-login
    would inherit an authenticated session otherwise."""
    client.get("/")  # get a pre-auth session
    pre = client.get_cookie(_session_cookie_name())
    pre_value = pre.value if pre else None

    _login(client, existing_user.email, "correct-horse-battery")
    post = client.get_cookie(_session_cookie_name())
    post_value = post.value if post else None

    assert post_value is not None, "no session cookie after login"
    assert post_value != pre_value, (
        "SESSION FIXATION: session id did not rotate on login"
    )


def test_session_cookie_has_httponly(client, existing_user):
    _login(client, existing_user.email, "correct-horse-battery")
    cookie = client.get_cookie(_session_cookie_name())
    assert cookie is not None
    # HttpOnly prevents document.cookie access → blocks XSS session theft.
    assert getattr(cookie, "http_only", False) or "HttpOnly" in str(cookie), (
        "session cookie missing HttpOnly — XSS can steal the session"
    )


def test_session_cookie_has_samesite(client, existing_user):
    _login(client, existing_user.email, "correct-horse-battery")
    cookie = client.get_cookie(_session_cookie_name())
    assert cookie is not None
    samesite = str(getattr(cookie, "same_site", "") or "").lower()
    assert samesite in ("lax", "strict"), (
        "session cookie missing SameSite=Lax|Strict — CSRF surface"
    )


def test_session_cookie_has_secure_in_prod(client, existing_user, monkeypatch):
    """In production (FLASK_ENV=production or equivalent), the
    Secure flag MUST be set — otherwise the cookie ships over
    plain HTTP on the first request after a downgrade attack."""
    monkeypatch.setenv("FLASK_ENV", "production")
    _login(client, existing_user.email, "correct-horse-battery")
    cookie = client.get_cookie(_session_cookie_name())
    assert cookie is not None
    assert getattr(cookie, "secure", False), (
        "production session cookie missing Secure — HTTP downgrade risk"
    )


def test_password_change_invalidates_other_sessions(existing_user):
    """When a user changes their password, sessions on OTHER devices
    MUST be invalidated. If not, a stolen session survives password
    rotation — the "I got phished" recovery path is broken."""
    # Two clients simulate two devices.
    from your_app import create_app  # adopter: import your app factory
    app = create_app({"TESTING": True})

    device_a = app.test_client()
    device_b = app.test_client()

    _login(device_a, existing_user.email, "correct-horse-battery")
    _login(device_b, existing_user.email, "correct-horse-battery")

    # Confirm both are authenticated.
    r_a = device_a.get("/api/me")
    r_b = device_b.get("/api/me")
    assert r_a.status_code == 200 and r_b.status_code == 200

    # Rotate password on device A.
    _change_password(device_a, existing_user, "new-passphrase-xyz")

    # Device B's session MUST no longer authenticate.
    r_b_after = device_b.get("/api/me")
    assert r_b_after.status_code in (401, 403), (
        "PASSWORD ROTATION did not invalidate other sessions — "
        f"device B still authenticated (status={r_b_after.status_code})"
    )


def test_logout_clears_server_session(client, existing_user):
    """After logout, the previously-authenticated cookie value MUST
    NOT authenticate. Client-side-only logout (`delete cookie`) is
    insufficient — the server MUST invalidate the session record."""
    _login(client, existing_user.email, "correct-horse-battery")
    old_cookie = client.get_cookie(_session_cookie_name())

    _logout(client)

    # Replay the old cookie — server must reject.
    client.set_cookie(
        _session_cookie_name(), old_cookie.value, domain="localhost"
    )
    r = client.get("/api/me")
    assert r.status_code in (401, 403), (
        "LOGOUT did not invalidate server session — replay attack open"
    )


