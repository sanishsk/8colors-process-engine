    raise NotImplementedError("wire to /auth/reset-request")


def _reset_with_token(client, token: str, new_password: str):
    raise NotImplementedError("wire to /auth/reset-confirm")


def _capture_reset_token(email: str) -> str:
    """Intercept the reset token from your test mail backend.
    Usually via `flask_mail.outbox` or Django's `mail.outbox`."""
    raise NotImplementedError("wire to your mail test backend")


