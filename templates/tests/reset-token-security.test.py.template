def test_reset_confirms_new_password_meets_policy(client, existing_user):
    """Password policy MUST apply on reset too (a common regression:
    the reset path bypasses complexity/length checks that the
    signup path enforces)."""
    _request_reset(client, existing_user.email)
    token = _capture_reset_token(existing_user.email)

    r = _reset_with_token(client, token, "abc")  # too short
    assert r.status_code in (400, 422), (
        "reset accepted a password that violates policy — path "
        "diverges from signup validation"
    )


def test_reset_confirm_is_timing_safe():
    """Token compare in the reset-confirm path MUST use
    hmac.compare_digest (not `==`). Otherwise, a timing side
    channel leaks the token character by character."""
    import hmac
    assert hasattr(hmac, "compare_digest"), (
        "hmac.compare_digest missing — Python too old"
    )
