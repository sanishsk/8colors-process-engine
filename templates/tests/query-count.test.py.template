# ─── The tests ───────────────────────────────────────────────────────
def test_list_endpoint_query_count_is_bounded():
    """The list endpoint must stay under MAX_QUERIES with a realistic row count."""
    _seed_rows(25)
    with count_queries() as c:
        resp = _call_list_endpoint()
    assert getattr(resp, "status_code", 200) < 400
    n = c["n"] if "n" in c else len(c["_ctx"].captured_queries)
    assert n <= MAX_QUERIES, (
        f"N+1 suspected: {n} queries for 25 rows (ceiling {MAX_QUERIES}). "
        f"Add eager loading (selectinload/joinedload or select_related/prefetch_related)."
    )


def test_list_endpoint_query_count_does_not_scale_with_rows():
    """The strongest N+1 signal: query count must NOT grow with N.
    Count at 5 rows and at 50 rows — the delta should be ~0, not ~45."""
    _seed_rows(5)
    with count_queries() as c1:
        _call_list_endpoint()
    n_small = c1["n"] if "n" in c1 else len(c1["_ctx"].captured_queries)

    _seed_rows(45)  # now 50 total
    with count_queries() as c2:
        _call_list_endpoint()
    n_large = c2["n"] if "n" in c2 else len(c2["_ctx"].captured_queries)

    # A constant-query endpoint has n_large ≈ n_small. An N+1 endpoint
    # has n_large ≈ n_small + (rows added). Allow a small constant slack.
    assert (n_large - n_small) <= 2, (
        f"N+1 confirmed: queries grew {n_small}→{n_large} when rows grew 5→50. "
        f"Query count scales with row count — classic N+1."
    )
