# query-count.test — the real N+1 detector (PF1).
#
# WHY THIS EXISTS: N+1 is the #1 silent SaaS performance killer — a page
# that fires 1 query in dev (10 rows) fires 1+N in prod (10k rows) and
# falls over. A black-box latency probe (the ai-testing-agent's
# `generate_n_plus_one_journeys`) can only *guess* from response times;
# it misses N+1 that's still fast on small dev data. The only reliable
# detector is IN-PROCESS query counting — you count the SQL the ORM
# actually emits and assert it does NOT grow with row count. That's what
# this template does, and why it lives in the adopter's own test suite
# (the engine gate can't reach inside your DB session from outside).
#
# THE CONTRACT: a list/detail endpoint must issue a CONSTANT number of
# queries regardless of how many rows it returns. If query count scales
# with N, you have an N+1 — fix with eager loading (SQLAlchemy
# `selectinload`/`joinedload`, Django `select_related`/`prefetch_related`).
#
# Adopter customization:
#   - Wire `db_session()` / `_query_counter()` to your stack (SQLAlchemy
#     and Django variants are both provided below — keep one, delete the
#     other).
#   - Wire `_seed_rows(n)` and `_call_list_endpoint()` to your app.
#   - Set MAX_QUERIES to your real ceiling (a constant, NOT a function
#     of N). Start strict; raise it only with a comment explaining why.
#   - Delete cases that don't apply — but delete them, don't silent-pass.

import pytest


# ─── Adopter wires these ─────────────────────────────────────────────
MAX_QUERIES = 10  # constant ceiling for the list endpoint; tune to reality


def _seed_rows(n: int) -> None:
    """Create `n` rows of the entity your list endpoint returns,
    each with the related data that tends to trigger N+1."""
    raise NotImplementedError("wire to your factory / DB helper")


def _call_list_endpoint():
    """Hit the list endpoint (test client) and return the response.
    Must actually touch the related data (serialize it) so lazy loads fire."""
    raise NotImplementedError("wire to your app's test client")


# ─── Query counter — SQLAlchemy variant (keep this OR the Django one) ──
from contextlib import contextmanager


@contextmanager
def count_queries():
    """Yield a mutable counter; counts every SQL statement executed on
    the bound engine for the duration of the block.

    SQLAlchemy: wire `_get_engine()` to your app's engine/bind.
    """
    from sqlalchemy import event

    engine = _get_engine()
    counter = {"n": 0}

    def _before(conn, cursor, statement, params, context, executemany):
        counter["n"] += 1

    event.listen(engine, "before_cursor_execute", _before)
    try:
        yield counter
    finally:
        event.remove(engine, "before_cursor_execute", _before)


def _get_engine():
    raise NotImplementedError("return your SQLAlchemy engine / bind")


