# .process-engine.yaml
# Project-level configuration for 8colors-process-engine.
# Place at the root of your target project. Used by install.sh and
# install_launchd.sh to render templates.
#
# Schema version: 1

schema_version: 1

project:
  # Short, lowercase, alphanumeric+dash. Used as the launchd label prefix
  # (com.<org_tag>.ceo.weekly) and the wrapper directory name
  # (~/.local/bin/<org_tag>-ceo/). Pattern: ^[a-z][a-z0-9-]*$
  org_tag: acme

  # Display name for reports and notifications.
  display_name: "Acme Corp"

  # Project root (absolute path). install.sh writes this from $1.
  # Leave as a placeholder if you're hand-editing; it gets overwritten.
  root: "/Users/you/code/acme"

  # Primary git branch — usually `main` or `master`.
  main_branch: master

# Sentry MCP integration (optional — skip if not using Sentry)
sentry:
  enabled: false
  organization_slug: ""
  project_slug: ""
  region_url: "https://us.sentry.io"   # or https://de.sentry.io for EU

# Weekly CEO retro automation (optional — macOS only via launchd)
ceo_weekly:
  enabled: true
  # Cron-like schedule: weekday + hour + minute.
  # weekday: 1=Mon, 2=Tue, ..., 5=Fri, 7=Sun
  schedule:
    weekday: 5
    hour: 17
    minute: 0
  # Watchdog freshness window in days (default 8 = weekly + 1 grace).
  staleness_days: 8
  # Headless model for the CEO weekly retro. The retro is strategic
  # synthesis over the past week's git + gate + memory signals — the
  # "foundational" tier of your model routing.
  #
  # Recommended ladder (Claude 5 era — 2026):
  #   Fable            — top-of-line judgment / hardest architectural calls
  #   claude-opus-4-8  — foundational (default for this field; strategic synthesis)
  #   claude-sonnet-5  — default working tier (feature implementation)
  #   claude-haiku-4-5 — mechanical passes with verifier gates
  #
  # If your Claude Code install doesn't yet have opus-4-8, drop to
  # sonnet-5 rather than pinning a deprecated version. Read the actual
  # model ID via `claude --list-models` (or your equivalent) and commit
  # what your install serves — don't inherit a stale pin from this
  # template.
  #
  # install_launchd.sh substitutes this into the rendered
  # run_weekly.sh templates (macOS/Linux/Windows). Fallback if
  # unset: claude-opus-4-8.
  model: claude-opus-4-8

# Session skills (start-session / end-session) installation
session_skills:
  # If true, install to ~/.claude/skills/ (user-global, applies to all projects).
  # If false, install to <project>/.claude/skills/ (project-only).
  install_user_global: true

# RAG over docs/research/ (optional — controlled by scripts/research_index.py)
rag:
  # Embedding provider. One of: fastembed | voyage | gemini | openai
  #
  #   fastembed — fully local, no API key, ~150 MB Python deps + ~33 MB model.
  #               BAAI/bge-small-en-v1.5 (384 dims). Default — adopter "just works".
  #   voyage    — Anthropic-recommended partner. voyage-3 (1024 dims).
  #               Set VOYAGE_API_KEY (free credit at voyageai.com).
  #   gemini    — Google text-embedding-004 (768 dims).
  #               Set GEMINI_API_KEY (free tier at aistudio.google.com/apikey).
  #   openai    — text-embedding-3-small (1536 dims). Paid but cheap.
  #               Set OPENAI_API_KEY.
  #
  # Resolution order (when provider is unset here):
  #   1. CLI --provider flag
  #   2. This rag.provider value
  #   3. Env detection (any of VOYAGE_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY)
  #   4. fastembed default
  provider: fastembed

  # Optional model override. Provider-specific default if unset.
  # model: BAAI/bge-small-en-v1.5

# Hook wiring (v0.10.0 default: enabled — the promises are only real
# when hooks are installed)
hooks:
  # Git-side pre-commit framework. If true, `pe install` renders
  # .pre-commit-config.yaml (unless one already exists) and runs
  # `pre-commit install --hook-type pre-commit --hook-type commit-msg
  #                    --hook-type pre-push` when the `pre-commit` binary
  # is on PATH.
  pre_commit_enabled: true

  # Claude Code hooks (PreToolUse/PostToolUse/Stop). If true, `pe install`
  # merges hooks/hooks.json into <project>/.claude/settings.json. Set to
  # false in projects where per-turn hooks would be too noisy (rare).
  claude_hooks_enabled: true

# Code-review gate (pre-commit-envelope-check). By default EVERY commit with
# a non-empty staged diff needs a fresh code-reviewer envelope — including a
# docs typo or a plan update.
#
# exempt_paths is an opt-in regex of paths that do NOT require review. It is
# an EXEMPT list, not an include list: anything you do not name is still
# gated, so a path you forget fails closed. The exemption is per-COMMIT, not
# per-file — a commit touching one exempt path and one source file is still
# gated, because git lands it whole.
#
# Unset means nothing is exempt. Override at runtime with
# ENGINE_REVIEW_EXEMPT_PATHS.
# review_gate:
#   exempt_paths: "^(docs/|CLAUDE\\.md$|.*\\.md$)"

# Security-review gate (security-review-trailer). Fires when a staged path
# matches (auth|login|oauth|session|passwd|password|payment|billing|webhook|
# jwt|token) as a SUBSTRING — deliberately, so authenticate.py and
# authorization.py are caught. The cost is words that mean something else in
# your codebase: a workout "session", a design "token".
#
# exempt_paths names those. It ADDS to the engine's own default exemption
# (its shipped *.template files, session docs and skills, design-token files)
# and never replaces it. Per-commit: one exempt path plus one auth path is
# still gated. An invalid regex exempts nothing. Override at runtime with
# ENGINE_SECURITY_EXEMPT_PATHS.
# security_gate:
#   exempt_paths: '^ios/.*Session[A-Za-z]*\.swift$'

# CLAUDE.md size guard. Set these ONLY to raise the limit temporarily while
# a split is in progress, and lower them as the file shrinks — the engine's
# standard is 12 KB warn / 20 KB fail, and CLAUDE.md is re-read on every
# turn, so the cost is per-turn forever.
#
# Set it HERE rather than in the .pre-commit-config.yaml entry line.
# claude-md-size runs in two modes — git-side pre-commit and Claude-side
# PostToolUse — and an `env VAR=...` on the pre-commit entry reaches only
# the first, so the two modes end up disagreeing about the same file.
# Both read this.
# claude_md:
#   warn_bytes: 12000
#   fail_bytes: 20000

# Project-specific session.yaml (start-session / end-session customization)
# Lives at <project>/.claude/session.yaml — engine doesn't manage it,
# but documents the contract here so adopters know it exists.
session_yaml_path: ".claude/session.yaml"

# ─── Simplicity toolchain (v0.13.0 — P6.2 / P6.3 / P5.4) ─────────────
# All three gates feature-detect their tools; missing tool = advisory
# skip. Config templates live at docs/templates/complexity/ after
# `pe install` (README there explains the ladder).

complexity_gate:
  enabled: true                # false to skip entirely
  strict: false                # true = xenon exit code becomes commit-blocking

duplication_gate:
  enabled: true
  baseline: .jscpd-baseline.json
  tolerance: 0.1               # allowed absolute % overshoot vs. baseline

size_budget:
  enabled: true
  warn_net_lines: 250          # WARN if commit's net-LOC delta > this
  fail_net_lines: 600          # FAIL unless `Size-justified:` trailer present
  max_file_lines: 800          # per-file hard cap (source paths only)
  max_function_lines: 50       # per-function cap (.py, .js/.ts best-effort)

# ─── Ponytail decision-ladder skill (v0.13.0 — P6.1) ─────────────────
# When true, `pe install --with-ponytail` (one-time) clones the Ponytail
# skill into ~/.claude/skills/ponytail/. The tdd-guide and
# build-error-resolver agents reference the ladder in their preambles.
# See: https://github.com/DietrichGebert/ponytail
ponytail:
  enabled: false               # opt-in — flip after `pe install --with-ponytail`

# ─── Product-quality gates (v0.14.0 — P5.x) ──────────────────────────

# P5.1 — "fresh clone boots" smoke check. Runs at CI + `pe doctor` (NOT
# on every commit — boot is slow). Adopter declares HOW to boot.
boot_check:
  enabled: false               # flip to true once you fill in the commands
  setup:     ""                # e.g. 'flask db upgrade' (create DB + migrate + seed)
  run:       ""                # e.g. 'flask run --port 5555' (long-running)
  probe_url: ""                # e.g. 'http://127.0.0.1:5555/login'
  timeout_seconds: 30
  expected_max_status: 500     # any HTTP < this counts as pass

# P5.2 — pre-commit lint of migration files. Forbids sys.exit + checks
# optional entrypoint regex. The definitive gate is CI-side ("run full
# chain against empty DB"); this hook is fail-fast.
migration_lint:
  enabled: true
  path_prefix: "migrations"    # relative to project root
  entrypoint_regex: ""         # e.g. '^def upgrade\(' + '^def downgrade\('

# P5.3 — deterministic design lint (multi-theme). Reads the theme
# spec from the file at design_lint.config (default .design-lint.yaml).
# A starter is at docs/templates/design-lint.config.template.
design_lint:
  enabled: true
  strict: false                # true = color-hex outside allowlist becomes FAIL
  config: ".design-lint.yaml"

# P5.7 — in-app copy lint. Flags AI-manifesto verbs, emoji-in-buttons,
# Title Case button labels. Default is WARN-only; flip strict=true to
# block commits.
copy_lint:
  enabled: true
  strict: false
  banned_phrases: ""           # semicolon-separated extra regexes

# P5.6 — nav confusion budget (used by the test template
# templates/tests/nav-confusion-budget.test.py). Import the file, wire
# the loader, and this number becomes the enforced cap.
confusion_budget:
  per_group: 5                 # max items per nav group before the test FAILs

# ─── Security (v0.17.0 — S1) ─────────────────────────────────────────
# hooks/sast-scan.sh feature-detects semgrep / bandit / gosec /
# eslint-plugin-security and runs the appropriate tools on staged
# files. Missing tool = advisory skip. FAIL only when a tool ran AND
# found HIGH+ (or MEDIUM+ under strict).
sast_gate:
  enabled: true                    # false to skip entirely
  strict: false                    # true = bandit MEDIUM+ becomes blocking
  semgrep_configs: ""              # comma-separated extra packs (e.g. "p/flask,p/django")
  allowlist: ".semgrep-allowlist.txt"

# ─── Design gate (v0.18.0 — D1) ───────────────────────────────────────
# hooks/design-review-trailer.sh requires a Design-reviewed trailer on
# multi-file UI commits, evidence-verified against .claude/gates/.
# Self-attest (Design-reviewed: design-critic) accepted only below the
# multi-file threshold.
design_gate:
  enabled: true                    # false disables the trailer requirement
  ui_threshold: 2                  # files >= this count → envelope-sha trailer required
  # UI regex — override ENGINE_UI_FILES if your project uses non-standard paths.

# ─── design-critic tuning (v0.40.0 — D5 ceiling; v0.46.0 — A9.3) ──────
# design-critic reads these when scoring in ceiling mode and when calling
# the run_visual_regression MCP tool. Absence → engine defaults.
design_critic:
  # A9.3 (v0.46.0): perceptual-similarity threshold ladder used when the
  # critic calls mcp__ai-testing-agent__run_visual_regression against a
  # flagship page + reference PNG.
  # - similarity ≥ perceptual_similarity_threshold        → PASS  (a9-3-perceptual-pass)
  # - perceptual_regression_threshold ≤ sim < threshold   → WARN  (a9-3-perceptual-drift)
  # - similarity < perceptual_regression_threshold        → FAIL  (a9-3-perceptual-regression)
  # Set both loose for design-in-motion products (dashboards with live
  # counters); set both strict for a locked marketing surface.
  perceptual_similarity_threshold: 0.95
  perceptual_regression_threshold: 0.90

# ─── performance-reviewer tuning (v0.47.0 — A9.4) ─────────────────────
# performance-reviewer reads these when calling
# mcp__ai-testing-agent__run_resilience_tests with measure_queries: true
# on the chaos runner. Absence → engine defaults (conservative SaaS
# baseline). Loosen for adopters on constrained infra; tighten for
# premium products.
performance_reviewer:
  # A9.4: chaos-runner load-generation parameters.
  resilience_concurrent_users: 50           # concurrent Locust users
  resilience_duration_seconds: 60           # test run duration
  # A9.4: verdict thresholds.
  # - queries_per_request_scale_factor > threshold →
  #     FAIL (a9-4-n-plus-one-under-load).  The PF1-hook-on-chaos-runner
  #     signal — query count grew >20% under load.
  resilience_query_scale_factor_threshold: 1.2
  # - queries_per_request_p95 > 2 × perf_gate query-count ceiling →
  #     FAIL (a9-4-query-scale-under-load).
  # - p95_latency_ms > threshold → FAIL (a9-4-latency-regression-under-load).
  resilience_p95_ms_threshold: 500
  # - error_rate > threshold → FAIL (a9-4-error-rate-under-load).
  resilience_error_rate_threshold: 0.01

# ─── Accessibility gate (v0.18.0 — D2) ────────────────────────────────
# axe-core Playwright spec (templates/e2e/a11y-audit.spec.ts.template)
# + Lighthouse CI (templates/ci/lighthouse-ci.yml.template) budgets.
# Adopter installs @axe-core/playwright + @lhci/cli locally.
a11y_gate:
  enabled: true                    # false to skip a11y assertions in CI
  wcag_level: "AA"                 # A | AA | AAA (WCAG 2.1)
  axe_config: ".axe-config.json"
  lighthouse_a11y_min: 90          # Lighthouse a11y score floor

# ─── Performance budgets (v0.18.0 — PF3) ──────────────────────────────
# Lighthouse budgets (LCP, TBT, bundle, images) + backend p95 latency
# assertions (templates/tests/latency-budget.test.py.template).
# Adopter installs @lhci/cli locally.
perf_budget:
  enabled: true                    # false to skip perf assertions in CI
  lighthouse_perf_min: 0.75        # Lighthouse performance score floor (0.0-1.0)
  lhci_config: ".lighthouserc.json"
  # Backend endpoint budgets live in templates/tests/latency-budget.test.py
  # (adopter populates ENDPOINTS with (method, path, budget_ms) tuples).

# ─── Static perf gate (v0.18.1 — PF2) ─────────────────────────────────
# hooks/sast-scan.sh loads a custom semgrep rule pack (via --config)
# in addition to the security packs. Rules catch: unbounded queries
# on list endpoints, missing-index candidates, blocking HTTP/sleep
# inside request handlers. Rule pack template at
# docs/templates/perf/semgrep-perf-rules.yml.template — copy to your
# project root and enable via the value below.
perf_gate:
  # Set to the path of the semgrep rule pack once you've copied the
  # template into place. Leaving blank = disabled (feature-detected).
  semgrep_rules: ""                # e.g. ".semgrep-perf-rules.yml"

# API breaking-change gate (A9.2). Blocks a commit when a committed OpenAPI/
# Swagger spec drops or changes an existing endpoint/param/field. Reuses the
# ai-testing-agent differ via `ai-test api-diff` (optional — advisory skip if
# ai-test isn't installed). No effect on projects without a committed spec.
api_contract_gate:
  enabled: true                    # false to skip entirely
  spec_globs: "openapi*.yaml openapi*.yml openapi*.json swagger*.yaml swagger*.yml swagger*.json"
