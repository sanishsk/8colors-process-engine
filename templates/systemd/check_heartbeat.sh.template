#!/usr/bin/env bash
# Heartbeat for the systemd-driven CEO weekly retro.
# Linux note: macOS uses osascript for desktop notifications; on Linux
# we use notify-send (libnotify) if available, else just write the
# stale marker file.

set -euo pipefail

PROJECT_ROOT="{{PROJECT_ROOT}}"
STATE_FILE="$PROJECT_ROOT/docs/dev-log/ceo-state.json"
STALE_MARKER="$PROJECT_ROOT/docs/dev-log/CEO_STALE.md"
ORG_TAG="{{ORG_TAG}}"

[ -f "$STATE_FILE" ] || exit 0

DAYS_STALE=$(/usr/bin/env python3 - <<PYEOF
import json, sys
from datetime import datetime, timezone
try:
    with open("$STATE_FILE") as f:
        s = json.load(f)
    last = s.get("last_run", "")
    if not last:
        print(-1); sys.exit(0)
    last_dt = datetime.fromisoformat(last.replace("Z", "+00:00"))
    delta = datetime.now(timezone.utc) - last_dt
    print(delta.days)
except Exception:
    print(-1)
PYEOF
)

if [ "$DAYS_STALE" -gt 8 ]; then
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "${ORG_TAG} CEO STALE" \
            "CEO weekly retro is $DAYS_STALE days stale. Check systemctl --user status ${ORG_TAG}-ceo-weekly.timer." \
            || true
    fi

    cat > "$STALE_MARKER" <<MARKER
# ⚠ CEO WEEKLY RETRO STALE

> Generated by check_heartbeat.sh on $(/bin/date -Iseconds)

The CEO weekly retro is **$DAYS_STALE days** old. Expected cadence
is every Friday at 17:00. Diagnose:

\`\`\`bash
systemctl --user status ${ORG_TAG}-ceo-weekly.timer
systemctl --user list-timers | grep ceo
journalctl --user -u ${ORG_TAG}-ceo-weekly.service -n 50
~/.local/bin/${ORG_TAG}-ceo/run_weekly.sh --force
\`\`\`

Delete this file once the weekly job is healthy again.
MARKER
fi

exit 0
