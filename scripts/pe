#!/usr/bin/env bash
# pe — 8colors-process-engine CLI (single entry point)
#
# Replaces direct invocation of install.sh / install_launchd.sh with a
# unified surface. Self-locates the engine directory based on its own
# location so it works whether you invoke it from the engine repo or
# via a symlink in ~/.local/bin.
#
# Subcommands:
#   pe install <project>      Install agents/commands/skills/scripts into project
#   pe launchd <project>      Wire macOS launchd weekly retro (macOS only)
#   pe upgrade                git pull the engine; symlinks auto-propagate to projects
#   pe status                 Show engine version, last commit, install paths
#   pe doctor [<project>]     Diagnose engine install (broken symlinks, missing deps)
#   pe baseline capture ...   Record a Phase 0 slot baseline (speed/size/quality)
#   pe gate parse <file>      Extract + validate gate-envelope JSON (E1)
#   pe version                Print engine version
#   pe help [<subcommand>]    Show help

set -euo pipefail

# ─── self-locate ────────────────────────────────────────────────────────────
SELF="${BASH_SOURCE[0]}"
# Resolve symlinks
while [ -h "$SELF" ]; do
    DIR=$(cd -P "$(dirname "$SELF")" && pwd)
    SELF=$(readlink "$SELF")
    [[ $SELF != /* ]] && SELF="$DIR/$SELF"
done
ENGINE_DIR=$(cd -P "$(dirname "$SELF")/.." && pwd)

if [ ! -f "$ENGINE_DIR/VERSION" ]; then
    echo "ERROR: cannot locate engine directory. Expected VERSION at $ENGINE_DIR/VERSION." >&2
    exit 2
fi

VERSION=$(cat "$ENGINE_DIR/VERSION")

# Source preset rosters + yaml subset reader (shared with install.sh)
# shellcheck source=./_subset.sh
. "$ENGINE_DIR/scripts/_subset.sh"

# ─── command groups ─────────────────────────────────────────────────────────
# Sourced, not executed. See each file's header for what lives where and why
# the split exists. `pe <subcommand>` behaviour is unchanged by it.
# shellcheck source=./_cmd_help.sh
. "$ENGINE_DIR/scripts/_cmd_help.sh"
# shellcheck source=./_cmd_lifecycle.sh
. "$ENGINE_DIR/scripts/_cmd_lifecycle.sh"
# shellcheck source=./_cmd_ops.sh
. "$ENGINE_DIR/scripts/_cmd_ops.sh"
# shellcheck source=./_cmd_docs.sh
. "$ENGINE_DIR/scripts/_cmd_docs.sh"

# ─── dispatch ───────────────────────────────────────────────────────────────

# Resolve a Python >= 3.11 interpreter (pe_orchestrator needs tomllib) —
# stock macOS `python3` is 3.9. Override with PE_PYTHON=<path>.
pe_python() {
    if [ -n "${PE_PYTHON:-}" ]; then
        echo "$PE_PYTHON"
        return 0
    fi
    local cand
    for cand in python3 python3.13 python3.12 python3.11; do
        if command -v "$cand" >/dev/null 2>&1 \
           && "$cand" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
            echo "$cand"
            return 0
        fi
    done
    echo "ERROR: pe requires Python 3.11+ on PATH; none found." >&2
    echo "  Fix: brew install python@3.12  (or set PE_PYTHON=/path/to/python3.11+)" >&2
    return 1
}


cmd="${1:-help}"
shift || true

case "$cmd" in
    audit)      cmd_audit "$@" ;;
    install)    cmd_install "$@" ;;
    launchd)    cmd_launchd "$@" ;;
    upgrade)    cmd_upgrade "$@" ;;
    sync)       cmd_sync "$@" ;;
    status)     cmd_status "$@" ;;
    doctor)     cmd_doctor "$@" ;;
    eject)      cmd_eject "$@" ;;
    baseline)   cmd_baseline "$@" ;;
    collect)    cmd_collect "$@" ;;
    skills-audit) cmd_skills_audit "$@" ;;
    telemetry)  cmd_telemetry "$@" ;;
    agent)      cmd_agent "$@" ;;
    incident)   cmd_incident "$@" ;;
    memory)     cmd_memory "$@" ;;
    new)        cmd_new "$@" ;;
    module)     cmd_module "$@" ;;
    gate)       cmd_gate "$@" ;;
    verify)     cmd_verify "$@" ;;
    recall)     cmd_recall "$@" ;;
    pin)        cmd_pin "$@" ;;
    shadow)     cmd_shadow "$@" ;;
    docs)       cmd_docs "$@" ;;
    version|-v|--version) echo "$VERSION" ;;
    help|-h|--help) help_subcommand "$@" ;;
    *)
        echo "ERROR: unknown subcommand: $cmd" >&2
        echo "Run 'pe help' for usage." >&2
        exit 2
        ;;
esac
