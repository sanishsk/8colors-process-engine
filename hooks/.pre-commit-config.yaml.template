# Engine-supplied pre-commit hooks
# Append these to your .pre-commit-config.yaml (or use as a starter).
#
# Install pre-commit if not already:
#     pip install pre-commit
#     pre-commit install --hook-type pre-commit --hook-type commit-msg

repos:
  - repo: local
    hooks:
      # Pre-commit (file content)
      - id: claude-md-size
        name: CLAUDE.md size guard (warns >12 KB, fails >20 KB)
        entry: hooks/claude-md-size.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: research-index-rebuild
        name: Rebuild semantic index when docs/research/ changes
        entry: hooks/research-index-rebuild.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]
        files: ^docs/research/.*\.md$

      # Commit-msg (trailer enforcement)
      - id: code-review-trailer
        name: Code-reviewed trailer required on multi-file commits
        entry: hooks/code-review-trailer.sh
        language: script
        stages: [commit-msg]

      - id: docs-updated-trailer
        name: Docs-updated trailer required on structural commits
        entry: hooks/docs-updated-trailer.sh
        language: script
        stages: [commit-msg]

      - id: design-review-trailer
        name: Design-reviewed trailer required on UI commits
        entry: hooks/design-review-trailer.sh
        language: script
        stages: [commit-msg]

      - id: security-review-trailer
        name: Security-reviewed trailer required on auth/payment paths
        entry: hooks/security-review-trailer.sh
        language: script
        stages: [commit-msg]

      - id: perf-gate
        name: Perf-tested trailer required on ORM / query / migration paths
        entry: hooks/perf-gate.sh
        language: script
        stages: [commit-msg]

      # Pre-commit (evidence-backed gates — v0.10.0)
      - id: test-run
        name: Run scoped tests before commit
        entry: hooks/test-run.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: secrets-scan
        name: Scan staged files for secrets
        entry: hooks/secrets-scan.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: deps-audit
        name: Audit dependency manifests for known vulnerabilities
        entry: hooks/deps-audit.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      # Pre-commit (simplicity toolchain — v0.13.0 / P6.2 / P6.3 / P5.4)
      - id: complexity-gate
        name: Complexity + dead-code (ruff C901/PLR, xenon, vulture, knip, eslint)
        entry: hooks/complexity-gate.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: size-budget
        name: Net-LOC + per-file + per-function size budgets
        entry: hooks/size-budget.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: duplication-gate
        name: Duplication ratchet (jscpd — must not raise baseline %)
        entry: hooks/duplication-gate.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      # Pre-commit (product-quality gates — v0.14.0 / P5.x)
      - id: migration-lint
        name: Migration contract (no sys.exit, entrypoint signature)
        entry: hooks/migration-lint.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: design-lint
        name: Deterministic design lint (multi-theme allowlists)
        entry: hooks/design-lint.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: motion-lint
        name: Motion-craft gate (prefers-reduced-motion + effect-stacking)
        entry: hooks/motion-lint.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: signature-lint
        name: Signature-system gate (D8 — flagship pages must reference a declared signature)
        entry: hooks/signature-lint.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: visual-baseline-guard
        name: Visual-baseline reference-must-exist advisory (D3 — flagship page edits should have a locked PNG)
        entry: hooks/visual-baseline-guard.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      - id: copy-lint
        name: In-app copy lint (AI-manifesto phrases, emoji-icons)
        entry: hooks/copy-lint.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      # Pre-commit (security — v0.17.0 / S1)
      - id: sast-scan
        name: SAST (semgrep + bandit + gosec + eslint-plugin-security)
        entry: hooks/sast-scan.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      # Pre-commit (API contract — v0.17.1 / A9.2)
      - id: api-contract-check
        name: API breaking-change gate (ai-test api-diff on committed specs)
        entry: hooks/api-contract-check.sh
        language: script
        pass_filenames: false
        stages: [pre-commit]

      # Pre-push (push-time gates)
      - id: stacking-rule-check
        name: Block foundational changes inside a slot-stack
        entry: hooks/stacking-rule-check.sh
        language: script
        pass_filenames: false
        stages: [pre-push]

# Tuning env vars (set before running git commit/push):
#   ENGINE_REVIEW_THRESHOLD=5      # min files before code-review trailer required
#   ENGINE_REVIEW_BEHAVIOR_PATHS=... # regex of behavior paths that trigger review at 1 file
#   ENGINE_STRUCTURAL_FILES=...    # regex of paths counted as "structural"
#   ENGINE_SECURITY_PATHS=...      # regex of paths requiring Security-reviewed trailer
#   ENGINE_UI_FILES=...            # regex of paths counted as "UI"
#   ENGINE_CLAUDE_MD_WARN=12000    # CLAUDE.md soft threshold (advisory)
#   ENGINE_CLAUDE_MD_FAIL=20000    # CLAUDE.md hard threshold (blocks commit)
#   ENGINE_CLAUDE_MD_LIMIT=NNNNN   # DEPRECATED: legacy single-threshold var,
#                                  # mapped to FAIL if only this is set.
#   PE_SKIP_CLAUDE_MD_SIZE=1       # one-shot bypass (logged in commit output)
#   PE_SKIP_COMPLEXITY=1           # bypass complexity-gate for one commit
#   PE_SKIP_SIZE_BUDGET=1          # bypass size-budget for one commit
#   PE_SKIP_DUPLICATION=1          # bypass duplication-gate for one commit
#   PE_SKIP_MIGRATION_LINT=1       # bypass migration-lint for one commit
#   PE_SKIP_DESIGN_LINT=1          # bypass design-lint for one commit
#   PE_SKIP_MOTION_LINT=1          # bypass motion-lint for one commit (D6)
#   PE_SKIP_SIGNATURE_LINT=1       # bypass signature-lint for one commit (D8)
#   PE_SKIP_VISUAL_BASELINE=1      # bypass visual-baseline-guard for one commit (D3)
#   PE_SKIP_COPY_LINT=1            # bypass copy-lint for one commit
#   PE_SKIP_BOOT_SMOKE=1           # bypass boot-smoke (used by pe doctor + CI)
#   PE_SKIP_SAST=1                 # bypass sast-scan for one commit
#   PE_SKIP_API_CONTRACT=1         # bypass api-contract-check for one commit
#   # size-budget net-lines gate accepts a `Size-justified: <reason>` trailer
#   ENGINE_FOUNDATIONAL_REGEX=...  # regex of paths counted as "foundational"
#   ENGINE_TEST_CMD=...            # explicit test command override (skips auto-detect)
#   ENGINE_TEST_FULL=1             # run full test suite instead of scoped
#   ENGINE_COVERAGE_MIN=80         # coverage-delta floor (pytest-cov / go test -cover)
#   ENGINE_SKIP_TESTS=1            # bypass test-run for this commit
#   ENGINE_SKIP_SECRETS=1          # bypass secrets-scan
#   ENGINE_SKIP_DEPS_AUDIT=1       # bypass deps-audit
